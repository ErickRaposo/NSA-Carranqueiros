  "components": {
    "portalCtaPair": {
      "description": "EntryPortal luminous white primary CTA paired with orbital blue outline CTA",
      "html": "<div class=\"ds-portal-cta-row\"><button type=\"button\" class=\"ds-portal-primary\">Iniciar exploração</button><button type=\"button\" class=\"ds-portal-outline\">Entrar na conta</button></div>",
      "css": ".ds-portal-cta-row{display:inline-flex;gap:12px;flex-wrap:wrap;font-family:'Poppins',system-ui,sans-serif}.ds-portal-primary{min-height:46px;padding:0 24px;border-radius:999px;border:none;background:#ffffff;color:#060913;font-size:14px;font-weight:600;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.35);transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms ease}.ds-portal-primary:hover{transform:translateY(-1px);background:#e2e8f0}.ds-portal-primary:active{transform:scale(.98)}.ds-portal-outline{min-height:46px;padding:0 20px;border-radius:999px;border:1.5px solid #2563eb;background:rgba(8,17,36,.72);color:#ffffff;font-size:14px;font-weight:600;cursor:pointer;transition:border-color 160ms ease,background-color 160ms ease}.ds-portal-outline:hover{border-color:#60a5fa;background:rgba(37,99,235,.14)}.ds-portal-primary:focus-visible,.ds-portal-outline:focus-visible{outline:2px solid #7dd3fc;outline-offset:2px}"
    },
    "orbitalCapsulePill": {
      "description": "1-line quiet obsidian floating capsule used for PlayerHUD session pill and Órbita Global",
      "html": "<button type=\"button\" class=\"ds-orbital-pill\"><span class=\"ds-orbital-avatar\">AD</span><span class=\"ds-orbital-name\">Administrador</span><span class=\"ds-orbital-meta\">11/25</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-orbital-pill{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:5px 12px 5px 7px;border-radius:999px;border:1px solid rgba(148,163,184,.16);background:rgba(6,12,26,.78);backdrop-filter:blur(16px);box-shadow:0 10px 26px rgba(0,0,0,.45);color:#f8fafc;font-family:'Poppins',system-ui,sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:border-color 150ms cubic-bezier(.23,1,.32,1),background 150ms cubic-bezier(.23,1,.32,1)}.ds-orbital-pill:hover{border-color:rgba(148,163,184,.32);background:rgba(10,17,34,.92)}.ds-orbital-pill:focus:not(:focus-visible){outline:none}.ds-orbital-pill:focus-visible{outline:2px solid #7dd3fc;outline-offset:2px}.ds-orbital-avatar{width:26px;height:26px;border-radius:50%;border:1px solid rgba(148,163,184,.22);background:rgba(255,255,255,.055);color:#e2e8f0;display:grid;place-items:center;font-size:10px;font-weight:600}.ds-orbital-name{letter-spacing:-.01em}.ds-orbital-meta{color:#94a3b8;font-size:11px;font-weight:500;font-variant-numeric:tabular-nums}"
    },
    "obsidianDrawerTelemetry": {
      "description": "18px obsidian drawer with segmented 2-tab bar and 3-column hairline telemetry strip",
      "html": "<section class=\"ds-drawer\"><div class=\"ds-tabs\"><button type=\"button\" class=\"ds-tab is-active\">Resumo</button><button type=\"button\" class=\"ds-tab\">Meus Dados</button></div><div class=\"ds-metrics\"><div class=\"ds-metric\"><strong>46</strong><span>Regiões</span></div><div class=\"ds-metric\"><strong>3</strong><span>Vozes</span></div><div class=\"ds-metric\"><strong>4/5</strong><span>Missões</span></div></div></section>",
      "css": ".ds-drawer{width:340px;padding:13px;border-radius:18px;background:rgba(8,13,25,.95);border:1px solid rgba(148,163,184,.16);backdrop-filter:blur(20px);box-shadow:0 24px 52px -12px rgba(2,6,20,.82),inset 0 1px 0 rgba(255,255,255,.04);display:flex;flex-direction:column;gap:11px;font-family:'Poppins',system-ui,sans-serif;color:#f8fafc}.ds-tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:3px;border-radius:10px;background:rgba(255,255,255,.035);border:1px solid rgba(148,163,184,.13)}.ds-tab{min-height:32px;border-radius:8px;border:1px solid transparent;background:transparent;color:#94a3b8;font-size:11.5px;font-weight:600;cursor:pointer}.ds-tab.is-active{background:rgba(255,255,255,.09);border-color:rgba(148,163,184,.22);color:#f8fafc}.ds-metrics{display:grid;grid-template-columns:repeat(3,1fr);border-radius:12px;background:rgba(255,255,255,.025);border:1px solid rgba(148,163,184,.12);overflow:hidden}.ds-metric{padding:9px 10px;display:flex;flex-direction:column;gap:2px;border-right:1px solid rgba(148,163,184,.12)}.ds-metric:last-child{border-right:none}.ds-metric strong{font-size:14px;font-weight:600;color:#f8fafc;font-variant-numeric:tabular-nums}.ds-metric span{font-size:10.5px;color:#94a3b8}"
    },
    "nasaStemIndicator": {
      "description": "Scientific NASA stem indicator chip using 6px semantic micro-dot without neon card clutter",
      "html": "<span class=\"ds-stem-chip\"><span class=\"ds-stem-dot\" style=\"background:#34d399\"></span>Baixo · NO₂</span>",
      "css": ".ds-stem-chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:rgba(255,255,255,.035);border:1px solid rgba(148,163,184,.16);color:#e2e8f0;font-family:'Poppins',system-ui,sans-serif;font-size:11px;font-weight:500}.ds-stem-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}"
    }
  },
