# ==============================================================================
# MINEIRØ — Free Credentials (Email OTP + Future Database)
# Copy this file to `.env.local` and fill in only your chosen provider.
# ==============================================================================

# Option 1 (100% free, no backend): EmailJS — up to 200 emails/month
# Create an account at https://www.emailjs.com/ and configure a template with:
# {{to_email}}, {{to_name}}, {{reset_code}}, {{app_name}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Option 2 (100% free, no table creation required): Supabase Free Tier
# Powers Multi-Device Online Rooms (?room=XXXXXX via Supabase Realtime Broadcast + Presence)
# and also serves overflow countries (~142 countries beyond the 100 in the repo) via Supabase Storage.
# Create a free project at https://supabase.com/ and copy Project URL + anon public key:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public bucket in Supabase Storage with remote countries (/countries/<id>/...)
VITE_SUPABASE_COUNTRIES_BUCKET=nasa-countries
# Optional: custom public URL (if empty, automatically uses ${VITE_SUPABASE_URL}/storage/v1/object/public/nasa-countries)
VITE_REMOTE_COUNTRIES_BASE_URL=

# Only for running the local upload script (node scripts/upload_countries_to_supabase.mjs) — NEVER use the VITE_ prefix
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: base path only if publishing to a subfolder (e.g., GitHub Pages /NSA-Carranqueiros/)
# On Vercel (root /), leave empty.
VITE_BASE_PATH=
