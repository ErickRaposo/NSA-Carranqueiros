# ==============================================================================
# MINEIRØ — Credenciais Gratuitas (E-mail OTP + Banco de Dados Futuro)
# Copie este arquivo para `.env.local` e preencha apenas o provedor escolhido.
# ==============================================================================

# Opção 1 (100% gratuita, sem backend): EmailJS — até 200 e-mails/mês
# Crie sua conta em https://www.emailjs.com/ e configure um template com:
# {{to_email}}, {{to_name}}, {{reset_code}}, {{app_name}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Opção 2 (100% gratuita, sem precisar criar tabelas): Supabase Free Tier
# Alimenta as Salas Online Multi-Dispositivo (?room=XXXXXX via Supabase Realtime Broadcast + Presence)
# Crie um projeto gratuito em https://supabase.com/ e copie Project URL + anon public key:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: caminho base apenas se publicar em subpasta (ex.: GitHub Pages /NSA-Carranqueiros/)
# Na Vercel (raiz /), deixe vazio.
VITE_BASE_PATH=
